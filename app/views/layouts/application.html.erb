<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Simple Transfers Service" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="brand">Simple Transfers</div>
      <% if current_user %>
        <div class="user-switcher">
          <span>Logged in as <strong><%= current_user.name %></strong></span>
          <% other_users.each do |u| %>
            <%= button_to "Switch to #{u.name}", switch_session_path(user_id: u.id), method: :post, form: { class: "inline" } %>
          <% end %>
        </div>
      <% end %>
    </header>

    <% if flash[:notice] %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="flash flash-alert"><%= flash[:alert] %></div><% end %>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
